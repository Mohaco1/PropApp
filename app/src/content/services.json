 "sq": {
  "PROC": {
   "delivery": {
    "controlledRef": {
     "label": "Controlled-medicine (S8) delivery procedure",
     "text": "For Schedule 8 medicines: a pharmacist checks and seals the package; it is handed only to the patient or an authorised adult after an identity check, with a signed record; undelivered S8 medicines come back to the pharmacy the same day and are recorded and returned to the S8 safe. [Confirm: these steps match the pharmacy’s S8 procedure and the 2026 Regulation checklist]"
    }
   },
   "vaccination": {
    "emergency": {
     "label": "Emergency (anaphylaxis) procedure",
     "text": "Keep an anaphylaxis response kit with in-date adrenaline at the vaccination area; observe patients after vaccination; if anaphylaxis occurs, give adrenaline as per the Australian Immunisation Handbook, call 000 and stay with the patient; record the event and report it as an adverse event following immunisation. [Confirm: steps match the current Handbook and NSW guidance]"
    }
   },
   "aged": {
    "handover": {
     "label": "Handover and escalation procedure",
     "text": "Urgent medication issues are escalated to the facility’s registered nurse in charge and the prescriber on the same day, and the communication is recorded. [Confirm: contacts and timeframes agreed with each facility]"
    }
   },
   "certificates": {
    "scopeEvidence": {
     "label": "Assessment and referral procedure",
     "text": "The pharmacist assesses the person in person, issues a certificate only for conditions within pharmacist scope and for the period the pharmacist can attest to, and refers the person to a doctor when symptoms are serious or outside scope. A record of each certificate is kept. [Confirm: steps match current professional guidance]"
    }
   },
   "vaping": {
    "scopeEvidence": {
     "label": "Vape supply procedure",
     "text": "Therapeutic vapes are supplied only under the current pathway the pharmacy uses (prescription or pharmacist supply after consultation), with the age, consultation and record requirements of that pathway. [Confirm: steps match current TGA and NSW requirements]"
    }
   },
   "nsp": {
    "safety": {
     "label": "Sharps and needlestick procedure",
     "text": "Use approved sharps containers and never recap needles; after a needlestick or exposure, wash the area, seek same-day medical assessment and record and report the incident. [Confirm: steps match the pharmacy’s infection-control arrangements]"
    }
   },
